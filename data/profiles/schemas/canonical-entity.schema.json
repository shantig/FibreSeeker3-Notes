{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fibreseeker-kb.local/schemas/canonical-entity.schema.json",
  "title": "FibreSeeker-KB canonical entity observation",
  "type": "object",
  "required": [
    "schema_version",
    "entity_record_id",
    "source_version_id",
    "source_software",
    "source_version",
    "source_ids",
    "provenance_class",
    "entity_type",
    "canonical_entity_id",
    "evidence_classification",
    "fields"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "entity_record_id": {"type": "string", "pattern": "^entity:[0-9a-f]{64}$"},
    "source_version_id": {"type": "string"},
    "source_software": {"enum": ["Aura", "Rocket"]},
    "source_version": {"type": "string"},
    "source_branch": {"type": "string"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "provenance_class": {"enum": ["ANISOPRINT_OFFICIAL", "FIBRESEEK_OFFICIAL"]},
    "acquired_utc": {"type": "array", "items": {"type": "string", "format": "date-time"}},
    "source_input_path": {"type": "string"},
    "source_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_format": {"enum": ["sqlite", "json_directory"]},
    "source_entity_type": {"type": "string"},
    "source_row_index": {"type": "integer", "minimum": 0},
    "entity_type": {"type": "string"},
    "canonical_entity_id": {"type": "string"},
    "original_entity_uuid": {"type": ["string", "null"]},
    "normalized_entity_uuid": {"type": ["string", "null"]},
    "application_key": {"type": ["integer", "null"]},
    "vendor_name": {"type": ["string", "null"]},
    "duplicate_in_source": {"type": "boolean"},
    "evidence_classification": {"const": "FACT"},
    "fields": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/field"}
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "classification": {"enum": ["FACT", "INFERENCE", "OPEN_QUESTION"]},
    "field": {
      "type": "object",
      "required": [
        "field_name",
        "original_field_name",
        "raw_value",
        "normalized_value",
        "base_value",
        "override_value",
        "override_present",
        "effective_value_status",
        "effective_value",
        "evidence_classification",
        "lineage_relationship"
      ],
      "properties": {
        "field_name": {"type": "string"},
        "original_field_name": {"type": "string"},
        "original_override_field_name": {"type": ["string", "null"]},
        "category": {"type": "string"},
        "raw_value": {"type": "object"},
        "normalized_value": {},
        "raw_unit": {"type": ["string", "null"]},
        "normalized_unit": {"type": ["string", "null"]},
        "unit_status": {"enum": ["known", "inferred", "unknown"]},
        "unit_evidence_classification": {"$ref": "#/$defs/classification"},
        "unit_source_ids": {"type": "array", "items": {"type": "string"}},
        "base_value": {},
        "override_value": {},
        "override_capable": {"type": "boolean"},
        "override_present": {"type": "boolean"},
        "runtime_precedence_documented": {"type": "boolean"},
        "runtime_precedence_source_ids": {"type": "array", "items": {"type": "string"}},
        "effective_value": {},
        "effective_value_status": {"enum": ["known", "inferred", "unknown"]},
        "effective_value_evidence_classification": {"$ref": "#/$defs/classification"},
        "evidence_classification": {"$ref": "#/$defs/classification"},
        "lineage_relationship": {"type": "string"},
        "alias_evidence_classification": {
          "anyOf": [{"$ref": "#/$defs/classification"}, {"type": "null"}]
        },
        "alias_source_ids": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
