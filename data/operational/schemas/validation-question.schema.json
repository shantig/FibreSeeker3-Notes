{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fibreseeker-kb/validation-question.schema.json",
  "title": "FibreSeek unknown or validation question",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_id", "domain", "question", "why_it_matters", "motivating_analog_record_ids", "evidence_needed", "resolution_class", "status", "notes"],
  "properties": {
    "question_id": {"type": "string", "pattern": "^FSQ-[0-9]{3}$"},
    "domain": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "why_it_matters": {"type": "string", "minLength": 1},
    "motivating_analog_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^OPK-[0-9]{4}$"}},
    "evidence_needed": {"type": "string", "minLength": 1},
    "resolution_class": {"enum": ["STATIC_FIRST_PARTY", "VENDOR_CONFIRMATION", "OFFLINE_RUNTIME_TEST", "PHYSICAL_EXPERIMENT"]},
    "status": {"enum": ["OPEN", "PARTIALLY_RESOLVED", "RESOLVED"]},
    "notes": {"type": "string"}
  }
}
