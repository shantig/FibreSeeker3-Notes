{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fibreseeker-kb/operational-knowledge.schema.json",
  "title": "Phase 2F-A operational knowledge record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "domain", "concept", "manufacturer_scope", "system_scope",
    "machine_scope", "software_scope", "material_scope", "source_ids",
    "source_references", "source_claim", "normalized_interpretation", "value",
    "unit", "qualifier", "evidence_classification", "assertion_kind",
    "guidance_status", "historical_context", "fibreseek_applicability",
    "confidence", "relationships", "unresolved_fibreseek_question", "notes"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^OPK-[0-9]{4}$"},
    "domain": {"enum": ["calibration", "manufacturability", "composite_layer_architecture", "fiber_path_generation", "design_rules", "materials_process", "cutter_feed_mechanics", "diagnostics", "maintenance"]},
    "concept": {"type": "string", "minLength": 1},
    "manufacturer_scope": {"enum": ["ANISOPRINT"]},
    "system_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "machine_scope": {"type": "array", "items": {"type": "string"}},
    "software_scope": {"type": "array", "items": {"type": "string"}},
    "material_scope": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2}-[0-9]{3,}$"}},
    "source_references": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "location"], "properties": {"source_id": {"type": "string"}, "location": {"type": "string", "minLength": 1}}}},
    "source_claim": {"type": "string", "minLength": 1},
    "normalized_interpretation": {"type": "string", "minLength": 1},
    "value": {"type": ["number", "integer", "string", "boolean", "null"]},
    "unit": {"type": ["string", "null"]},
    "qualifier": {"type": ["string", "null"]},
    "evidence_classification": {"enum": ["ANISOPRINT_OFFICIAL", "INFERENCE"]},
    "assertion_kind": {"enum": ["DOCUMENTATION_CLAIM", "PROCEDURE", "PROFILE_VALUE", "CODE_BEHAVIOR", "CODE_CONSTANT", "CODE_DEFAULT", "COMMENT", "HUMAN_TIMESTAMP_NOTE"]},
    "guidance_status": {"enum": ["HISTORICAL_ANISOPRINT_GUIDANCE", "HISTORICAL_ANISOPRINT_DESCRIPTION", "NOT_GUIDANCE", "UNVERIFIED_NOTE"]},
    "historical_context": {"type": "string", "minLength": 1},
    "fibreseek_applicability": {"enum": ["CONFIRMED_EQUIVALENT", "POSSIBLE_ANALOG", "CONCEPTUAL_ANALOG", "NO_KNOWN_EQUIVALENT", "CONTRADICTED", "UNRESOLVED"]},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNVERIFIED"]},
    "relationships": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["type", "target", "notes"], "properties": {"type": {"enum": ["historical_ancestor", "same_name_field", "semantically_similar", "possible_analog", "unresolved_relationship", "part_of", "precedes", "verifies", "causes", "tests", "corrects"]}, "target": {"type": "string", "minLength": 1}, "notes": {"type": "string"}}}},
    "unresolved_fibreseek_question": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}
