{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fibreseeker-kb/training-video.schema.json",
  "title": "Official training-video inventory record",
  "type": "object",
  "additionalProperties": false,
  "required": ["video_id", "title", "course", "canonical_page", "page_source_id", "host", "host_video_id", "host_url", "publication_date", "duration", "description", "relevance", "related_written_source_ids", "transcript_status", "transcript_source_id", "annotation_status", "notes"],
  "properties": {
    "video_id": {"type": "string", "pattern": "^VID-AP-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "course": {"type": "string", "minLength": 1},
    "canonical_page": {"type": "string", "format": "uri"},
    "page_source_id": {"type": "string", "pattern": "^AP-[0-9]{3,}$"},
    "host": {"enum": ["VIMEO"]},
    "host_video_id": {"type": "string", "pattern": "^[0-9]+$"},
    "host_url": {"type": "string", "format": "uri"},
    "publication_date": {"type": ["string", "null"]},
    "duration": {"type": ["string", "null"], "pattern": "^[0-9]+:[0-9]{2}$"},
    "description": {"type": ["string", "null"]},
    "relevance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["fundamentals", "design", "Aura", "macrolayers", "reinforcement", "materials", "hardware_operation", "calibration", "diagnostics", "maintenance"]}},
    "related_written_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "transcript_status": {"enum": ["PUBLIC_ACQUIRED", "NOT_PUBLICLY_EXPOSED", "BLOCKED", "UNRESOLVED"]},
    "transcript_source_id": {"type": ["string", "null"]},
    "annotation_status": {"enum": ["READY_FOR_HUMAN_NOTES", "ANNOTATED", "NOT_REQUIRED"]},
    "notes": {"type": "string"}
  }
}
